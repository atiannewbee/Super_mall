# Copy this file to .env.properties and replace the values for local development.
DB_URL=jdbc:mysql://localhost:3306/super_mall?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# 商家端必须使用与消费者端不同的 JWT 密钥。
MERCHANT_JWT_SECRET=replace-with-another-random-secret-at-least-32-bytes
MERCHANT_JWT_ISSUER=super-mall-merchant-backend
MERCHANT_JWT_AUDIENCE=super-mall-merchant-api
MERCHANT_JWT_ACCESS_TOKEN_TTL=PT2H
# 仅用于首次创建商家主管账号。创建并完成首次改密后，生产环境应移除密码变量。
MERCHANT_BOOTSTRAP_EMAIL=owner@example.com
MERCHANT_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
MERCHANT_BOOTSTRAP_NAME=商家主管
# 本地联调模拟支付时开启；生产环境和真实支付环境必须改为 false。
PAYMENT_SANDBOX_ENABLED=true
ALIPAY_ENABLED=false
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
# Paste the one-line Base64 key content only. Never commit the real key.
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
# Must be an HTTPS URL reachable by Alipay, for example:
ALIPAY_NOTIFY_URL=https://api.example.com/api/payments/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/checkout/result
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ORDER_PENDING_PAYMENT_TTL=PT30M
ORDER_EXPIRATION_SCAN_INTERVAL=PT1M
